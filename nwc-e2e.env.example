# Copy to a separate file outside git, chmod 600, and fill with THREE newly
# created/revoked-after-run NWC connections. Never use ~/openln/.env here.
NWC_TEST_URL=nostr+walletconnect://<platform-wallet-pubkey>?relay=wss://relay.example&secret=<platform-secret>
NWC_USER_URL=nostr+walletconnect://<funded-sender-pubkey>?relay=wss://relay.example&secret=<sender-secret>
NWC_SENDER_URL=nostr+walletconnect://<merchant-pubkey>?relay=wss://relay.example&secret=<merchant-secret>

# The runner intentionally requires DATABASE_URL separately and only accepts
# an isolated database named openln_test (not openln_dev or production).
