{
  "manifest_version": 3,
  "name": "openLN Card Bridge",
  "version": "1.0.0",
  "description": "Write and wipe NTAG424 DNA Bolt Cards from the openLN webapp using a local USB NFC reader (ACR122U, ACR1252U, any PC/SC).",
  "key": "",
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://openln.com/*",
        "https://www.openln.com/*",
        "https://dev.openln.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://openln.com/*",
        "https://www.openln.com/*",
        "https://dev.openln.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ],
      "js": ["content-relay.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["nativeMessaging"]
}
